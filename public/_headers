/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://raw.githubusercontent.com https://cdn.jsdelivr.net https://images.weserv.nl; connect-src 'self' https://*.upstash.io https://api.github.com https://cdn.jsdelivr.net https://cloudflareinsights.com; frame-src 'self' https://maps.google.com https://www.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self';

# Cache inmutable de 1 año para assets estáticos versionados
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML sin cache obsoleto para reflejar deploys de inmediato
/*.html
  Cache-Control: public, max-age=0, must-revalidate
